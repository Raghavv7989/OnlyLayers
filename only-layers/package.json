{
  "name": "only-layers",
  "version": "1.0.0",
  "description": "Stealth Desktop AI Copilot for Live Technical Interviews & Pair Programming",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5174 && cross-env NODE_ENV=development VITE_PORT=5174 node electron-runner.js .\"",
    "start": "npm run build && node electron-runner.js .",
    "dist": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && tsc -p tsconfig.electron.json && npx electron-builder --mac --arm64",
    "install:mac": "npm run build:mac && cp -R release-mac/mac-arm64/AudioUtilityService.app /Applications/"
  },
  "keywords": [
    "electron",
    "copilot",
    "stealth",
    "gemini",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.7.1",
    "lucide-react": "^1.64.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.audio.utility.service",
    "productName": "AudioUtilityService",
    "directories": {
      "output": "release-mac"
    },
    "mac": {
      "target": [
        "dir",
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlementsInherit": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "NSScreenCaptureUsageDescription": "Utility requires screen audio loopback access.",
        "NSMicrophoneUsageDescription": "Utility requires audio stream access.",
        "NSAppleEventsUsageDescription": "Utility requires accessibility shortcut listener."
      }
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  }
}
